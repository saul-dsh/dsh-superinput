{
  "name": "dsh-superinput",
  "version": "0.3.3",
  "description": "Super input box suite for the DeepSeek Harness (dsh): model & effort picker, prompt enhancement, follow-up suggestions, full cost engine (billing, backfill, price sync, forecast), voice input, snippet & prompt template managers and a settings hub — one plugin, eight input-area modules with per-module failure isolation.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "modules",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "composer",
    "cost",
    "picker",
    "snippets",
    "suite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saul-dsh/dsh-superinput.git"
  },
  "homepage": "https://github.com/saul-dsh/dsh-superinput#readme",
  "bugs": {
    "url": "https://github.com/saul-dsh/dsh-superinput/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
